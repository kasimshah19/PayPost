# Frontend Vite Environment Variables (Local Development)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Production on Vercel:
# Set in Vercel Dashboard -> Settings -> Environment Variables:
# VITE_API_URL=https://paypost.onrender.com/api
# VITE_SOCKET_URL=https://paypost.onrender.com
#
# CRITICAL: Vite bakes VITE_* variables into client JavaScript at BUILD time.
# After adding or updating variables in Vercel, you MUST trigger a Redeploy.
