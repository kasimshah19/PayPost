# Server Configuration
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/paypost?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_min_32_characters_random
CLIENT_URL=http://localhost:5173

# Withdrawal Worker & Payout Mock Provider Settings (Phases 7 & 10)
# MOCK_PAYOUT_MODE options: random | always_success | always_fail | deterministic
MOCK_PAYOUT_MODE=random
MOCK_PAYOUT_DELAY_MS=4000
MOCK_PAYOUT_SUCCESS_RATE=0.7
WORKER_ENABLED=true
WORKER_INTERVAL_MS=3000
STUCK_PROCESSING_AFTER_MS=60000

# Notification Worker & Mock Dispatcher Settings (Phases 8 & 10)
# MOCK_NOTIFY_MODE options: random | always_success | always_fail | deterministic
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_STUCK_AFTER_MS=60000
MOCK_NOTIFY_MODE=random
MOCK_NOTIFY_SUCCESS_RATE=0.9
MOCK_NOTIFY_DELAY_MS=200

# Developer Tools Flag (Phase 8 dev clock & simulated time shifts)
# Set to true ONLY in development / testing environments
ENABLE_DEV_TOOLS=false
